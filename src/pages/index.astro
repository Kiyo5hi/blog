---
import Base from '../layouts/Base.astro'
import Profile from '../components/Profile.astro'
import { getPosts } from '../lib/posts'
import { site } from '../lib/site'
const posts = await getPosts()
---
<Base title="Home">
  <div class="flex flex-col gap-4">
    {posts.map(post => <section class="card p-4">
      <h2 class="text-2xl mb-2"><a href={post.path}>{post.data.title}</a></h2>
      <div class="text-slate-400">{post.data.description}</div>
      <div class="flex justify-end"><a href={post.path} class="text-blue-500 py-1 px-2 rounded-lg transition hover:bg-gray-200 dark:hover:bg-slate-700 hover:scale-105">Read more...</a></div>
    </section>)}
    <Profile name={site.author} avatar={site.avatar} vertical>
      <div class="mx-auto mt-4 flex gap-2 items-center justify-center">
        <div class="w-24"><div>Posts</div><div>{posts.length}</div></div>
        <div class="w-24"><div>Categories</div><div>{new Set(posts.map(post => post.data.category)).size}</div></div>
      </div>
    </Profile>
  </div>
</Base>
