---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Comments from '../../components/Comments.astro'
import { getPosts, formatDate } from '../../lib/posts'
import { site } from '../../lib/site'
import 'katex/dist/katex.min.css'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, index) => ({ params: { slug: post.id }, props: {
    post, prev: posts[index - 1], next: posts[index + 1]
  } }))
}
const { post, prev, next } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)
const article = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  datePublished: post.createdAt, dateModified: post.updatedAt,
  author: { '@type': 'Person', name: site.author, url: 'https://kiyo5hi.com' },
  mainEntityOfPage: new URL(post.path, Astro.site).href
}
---
<Base title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.createdAt} />
    <meta property="article:modified_time" content={post.updatedAt} />
    <script type="application/ld+json" set:html={JSON.stringify(article).replace(/</g, '\\u003c')} />
  </Fragment>
  <div class="flex flex-col gap-4">
    <div class="card px-6 py-4">
      <article class="prose max-w-none dark:prose-invert prose-pre:shadow-md">
        <h1>{post.data.title}</h1>
        <p class="text-slate-400 flex flex-wrap gap-2">
          <time datetime={post.createdAt}>{formatDate(post.createdAt)}</time><span>|</span>
          <span>{post.data.category}</span><span>|</span><span>{remarkPluginFrontmatter.readingTime.text}</span>
        </p>
        <div class="post-content"><Content /></div>
      </article>
    </div>
    <nav aria-label="Adjacent posts" class="flex justify-between text-slate-400 gap-3">
      <div class="flex-1 my-auto">{prev && <a href={prev.path} rel="prev" class="flex items-center gap-2"><span aria-hidden="true">‹</span><span>{prev.data.title}</span></a>}</div>
      <div class="flex-1 my-auto">{next && <a href={next.path} rel="next" class="flex items-center justify-end gap-2 text-right"><span>{next.data.title}</span><span aria-hidden="true">›</span></a>}</div>
    </nav>
    <section class="card px-6 py-4" aria-label="Comments"><Comments /></section>
  </div>
</Base>
