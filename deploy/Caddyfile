{
    admin off
    auto_https off
    persist_config off
}

:3000 {
    root * /srv
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Cache-Control "no-cache"
    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @trailing path_regexp trailing ^(.+)/$
    redir @trailing {re.trailing.1} 308
    try_files {path}.html {path}/index.html {path}
    file_server
    handle_errors {
        header Cache-Control "no-store"
        rewrite * /404.html
        file_server
    }
}
